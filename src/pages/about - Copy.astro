/* You can leave this empty for now, but the dashes must be here! */
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nicole | Digital Portfolio</title>
    <style>
        :root {
            --bg-dark: #0f172a;       /* Deep slate/navy dark background */
            --bg-card: #1e293b;       /* Slightly lighter card background */
            --text-main: #f8fafc;     /* Crisp white text */
            --text-muted: #94a3b8;    /* Gray muted text for paragraphs */
            --accent-pink: #d81b60;   /* Strong pink accent */
            --accent-hover: #ad144b;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        }

        body {
            background-color: var(--bg-dark);
            color: var(--text-main);
            line-height: 1.6;
        }

        /* Navigation */
        nav {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 30px 5%;
            max-width: 1200px;
            margin: 0 auto;
        }

        .logo {
            font-size: 24px;
            font-weight: 700;
            color: var(--text-main);
            text-decoration: none;
            letter-spacing: 1px;
        }

        .logo span {
            color: var(--accent-pink);
        }

        .nav-links a {
            color: var(--text-main);
            text-decoration: none;
            margin-left: 30px;
            font-size: 15px;
            transition: color 0.3s;
        }

        .nav-links a:hover {
            color: var(--accent-pink);
        }

        /* Hero Section */
        header {
            padding: 100px 5% 80px;
            max-width: 1200px;
            margin: 0 auto;
        }

        .greeting {
            color: var(--accent-pink);
            font-weight: 600;
            font-size: 18px;
            margin-bottom: 10px;
            display: block;
        }

        h1 {
            font-size: 3.5rem;
            line-height: 1.2;
            margin-bottom: 20px;
        }

        .bio {
            color: var(--text-muted);
            font-size: 1.2rem;
            max-width: 600px;
            margin-bottom: 40px;
        }

        /* Projects Section */
        section {
            padding: 60px 5%;
            max-width: 1200px;
            margin: 0 auto;
        }

        h2 {
            font-size: 2rem;
            margin-bottom: 40px;
            display: flex;
            align-items: center;
            gap: 15px;
        }

        h2::after {
            content: "";
            height: 1px;
            flex: 1;
            background-color: #334155;
        }

        .grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 30px;
        }

        .card {
            background-color: var(--bg-card);
            border-radius: 12px;
            padding: 30px;
            transition: transform 0.3s, box-shadow 0.3s;
            border: 1px solid #334155;
        }

        .card:hover {
            transform: translateY(-5px);
            border-color: var(--accent-pink);
            box-shadow: 0 10px 30px rgba(216, 27, 96, 0.1);
        }

        .card-tag {
            color: var(--accent-pink);
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 1px;
            font-weight: 600;
            margin-bottom: 10px;
            display: block;
        }

        .card h3 {
            font-size: 1.5rem;
            margin-bottom: 15px;
        }

        .card p {
            color: var(--text-muted);
            margin-bottom: 25px;
            font-size: 0.95rem;
        }

        .card-links a {
            color: var(--text-main);
            text-decoration: none;
            font-size: 14px;
            font-weight: 600;
            margin-right: 20px;
            transition: color 0.3s;
        }

        .card-links a:hover {
            color: var(--accent-pink);
        }

        /* Footer */
        footer {
            text-align: center;
            padding: 40px 5%;
            color: var(--text-muted);
            font-size: 14px;
            border-top: 1px solid #334155;
            margin-top: 60px;
        }
    </style>
</head>
<body>

    <nav>
        <a href="#" class="logo">Nicole<span>.</span></a>
        <div class="nav-links">
            <a href="#about">About</a>
            <a href="#projects">Projects</a>
            <a href="mailto:your-email@example.com">Contact</a>
        </div>
    </nav>

    <header id="about">
        <span class="greeting">Hi there!, my name is Nicole Lara.</span>
        <h1>I engineer systems, build web apps, and push limits.</h1>
	<break>
	<h2>Three Passions: Aviation, Computers, Kindness.</h2>
        <p class="bio">
            I am a Computer Engineering graduate student building solutions at the intersection of hardware and software. When I am not developing tech architectures, you can find me training for my next half marathon or working toward my goal of becoming a pilot.
        </p>
    </header>

    <section id="projects">
        <h2>Selected Projects</h2>
        
        <div class="grid">
            <div class="card">
                <span class="card-tag">Hardware & Machine Learning</span>
                <h3>BCI Wheelchair Prototype</h3>
                <p>Engineered a non-invasive Brain-Computer Interface (BCI) system. Developed the real-time processing architecture using EEG headsets and Arduino motor drivers for motor imagery control.</p>
                <div class="card-links">
			<a href="BCI_Thesis.pdf" target="_blank">Read Full Thesis (PDF) &rarr;</a>
                </div>
            </div>

            <div class="card">
                <span class="card-tag">Frontend & Marketing</span>
                <h3>StrongHerEra (SHE)</h3>
                <p>Designed and deployed a responsive digital funnel for fitness guides. Integrated webhooks for automated email capture, built entirely from scratch with HTML, CSS, and JS.</p>
                <div class="card-links">
                    <!-- Replace with your actual SHE Vercel URL -->
                    <a href="https://strongherera-landing.vercel.app/" target="_blank">Visit Site &rarr;</a>
                </div>
            </div>

            <div class="card">
                <span class="card-tag">Writing & Static Site Generation</span>
                <h3>Personal Blog</h3>
                <p>A technical writing platform built with the Astro framework. Automates markdown files into highly optimized, lightning-fast static HTML pages via GitHub and Vercel CI/CD pipelines.</p>
                <div class="card-links">
                    <!-- Replace with your actual Blog Vercel URL -->
                    <a href="https://nicoledonny-imagine-blogs.vercel.app/" target="_blank">Read Articles &rarr;</a>
                </div>
            </div>
        </div>
    </section>

    <footer>
        &copy; 2026 Nicole. Engineered from scratch.
    </footer>

</body>
</html>