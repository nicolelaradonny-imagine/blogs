---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="Nicole | Digital Portfolio" description="Engineering Portfolio and Blog" />
		<style>
			/* Portfolio Specific Styles */
			.hero-section-portfolio {
				padding: 60px 5% 40px;
				max-width: 1200px;
				margin: 0 auto;
			}

			.greeting {
				color: var(--accent-pink);
				font-weight: 600;
				font-size: 18px;
				margin-bottom: 10px;
				display: block;
			}

			h1.portfolio-title {
				font-size: 3.5rem;
				line-height: 1.2;
				margin-bottom: 20px;
			}

			.bio {
				color: var(--text-muted);
				font-size: 1.2rem;
				max-width: 600px;
				margin-bottom: 40px;
			}

			/* Projects Section */
			.projects-section {
				padding: 20px 5% 60px;
				max-width: 1200px;
				margin: 0 auto;
			}

			.projects-section h2 {
				font-size: 2rem;
				margin-bottom: 40px;
				display: flex;
				align-items: center;
				gap: 15px;
			}

			.projects-section h2::after {
				content: "";
				height: 1px;
				flex: 1;
				background-color: #334155;
			}

			.grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
				gap: 30px;
			}

			.card {
				background-color: var(--bg-card);
				border-radius: 12px;
				padding: 30px;
				transition: transform 0.3s, box-shadow 0.3s;
				border: 1px solid #334155;
			}

			.card:hover {
				transform: translateY(-5px);
				border-color: var(--accent-pink);
				box-shadow: 0 10px 30px rgba(216, 27, 96, 0.1);
			}

			.card-tag {
				color: var(--accent-pink);
				font-size: 12px;
				text-transform: uppercase;
				letter-spacing: 1px;
				font-weight: 600;
				margin-bottom: 10px;
				display: block;
			}

			.card h3 {
				font-size: 1.5rem;
				margin-bottom: 15px;
			}

			.card p {
				color: var(--text-muted);
				margin-bottom: 25px;
				font-size: 0.95rem;
			}

			.card-links a {
				color: var(--text-main);
				text-decoration: none;
				font-size: 14px;
				font-weight: 600;
				margin-right: 20px;
				transition: color 0.3s;
			}

			.card-links a:hover {
				color: var(--accent-pink);
			}
		</style>
	</head>
	<body>
		<!-- This injects Astro's master navigation bar! -->
		<Header />
		
		<main>
			<section class="hero-section-portfolio">
				<span class="greeting">Hi there!, my name is Nicole Lara.</span>
				<h1 class="portfolio-title">I engineer systems, build web apps, and push limits.</h1>
				
				<br />
				
				<h2>Three Passions: Aviation, Computers, Kindness.</h2>
				<p class="bio">
					I am a Computer Engineering graduate student building solutions at the intersection of hardware and software. When I am not developing tech architectures, you can find me training for my next half marathon or working toward my goal of becoming a pilot.
				</p>
			</section>

			<section class="projects-section">
				<h2>Selected Projects</h2>
				
				<div class="grid">
					<div class="card">
						<span class="card-tag">Hardware & Machine Learning</span>
						<h3>BCI Wheelchair Prototype</h3>
						<p>Engineered a non-invasive Brain-Computer Interface (BCI) system. Developed the real-time processing architecture using EEG headsets and Arduino motor drivers for motor imagery control.</p>
						<div class="card-links">
							<a href="/BCI_Thesis.pdf" target="_blank">Read Full Thesis (PDF) &rarr;</a>
						</div>
					</div>

					<div class="card">
						<span class="card-tag">Frontend & Marketing</span>
						<h3>StrongHerEra (SHE)</h3>
						<p>Designed and deployed a responsive digital funnel for fitness guides. Integrated webhooks for automated email capture, built entirely from scratch with HTML, CSS, and JS.</p>
						<div class="card-links">
							<a href="https://strongherera-landing.vercel.app/" target="_blank">Visit Site &rarr;</a>
						</div>
					</div>

					<div class="card">
						<span class="card-tag">Writing & Static Site Generation</span>
						<h3>Personal Blog</h3>
						<p>A technical writing platform built with the Astro framework. Automates markdown files into highly optimized, lightning-fast static HTML pages via GitHub and Vercel CI/CD pipelines.</p>
						<div class="card-links">
							<a href="/blog">Read Articles &rarr;</a>
						</div>
					</div>
				</div>
			</section>
		</main>
		
		<!-- This injects Astro's master footer! -->
		<Footer />
	</body>
</html>